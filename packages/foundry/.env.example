# Copy to .env (done automatically on install) and adjust as needed.

# Hedera JSON-RPC endpoint (testnet default; use https://mainnet.hashio.io/api for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Keystore used for localhost deploys. Use your own (yarn foundry:account:generate) for testnet/mainnet.
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-hbar-default

# --- Launchpad deployment (script/Deploy.s.sol) ---
# HBAR a bonding curve must raise before it graduates into SaucerSwap (default 100).
GRADUATION_THRESHOLD_HBAR=25
# Address receiving the 1% curve trading fee (defaults to the deployer).
FEE_RECIPIENT=

# --- yarn foundry:demo ---
# Optional: private key for non-interactive demo runs (CI). Leave empty to pick a keystore.
DEMO_PRIVATE_KEY=
