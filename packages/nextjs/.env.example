# Copy to .env.local. Everything is optional: without changes the app talks to Hedera testnet
# and the Launchpad deployment recorded in contracts/deployedContracts.ts.

# --- Wallet / RPC ---
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=

# --- Mirror node (indexer for launches, trades, charts, comments) ---
NEXT_PUBLIC_MIRROR_NODE_TESTNET_URL=
NEXT_PUBLIC_MIRROR_NODE_MAINNET_URL=

# --- HCS comment threads (optional) ---
# "testnet" (default) or "mainnet" — network used by /api/comments and the topic script.
NEXT_PUBLIC_HEDERA_NETWORK=testnet
# Topic created by `yarn next:hcs:create-topic`. Leave empty to disable comments.
NEXT_PUBLIC_HCS_TOPIC_ID=
# Server-only relayer account that pays for HCS messages. Must be the topic's submit key. ECDSA key.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
